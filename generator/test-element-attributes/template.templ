package testelementattributes

css important() {
	width: 100;
}

css unimportant() {
	width: 50;
}

templ render(p person) {
	<div
		style="width: 100"
		if p.important {
			class={ important() }
		}
	>Important</div>
	<div
		style="width: 100"
		if !p.important {
			class={ unimportant }
		}
	>Unimportant</div>
	<div
		style="width: 100"
		if p.important {
			class={ important }
		} else {
			class={ unimportant }
		}
	>Else</div>
	<div
		data-script="on click
                do something
             end"
	></div>
	<h2>htmx Wildcard attribute</h2>
	<form
		{ "dynamic"+"-attr-key" }={ "hello world" }
		{ "dynamic"+"-const-key" }="hello world"
		{ "my-string" + "-attr" }
		{ "bool-" + "attr" }?={ true }
		{ "bool-" + "attr-false" }?={ false }
		hx-post="/api/secret/unlock"
		hx-target="#secret"
		hx-target-*="#errors"
		hx-indicator="#loading-indicator"
	>
		<input type="button" value="Unlock"/>
	</form>
}

script handleDynamicKeyClick() {
	alert("dynamic");
}

// dynamicKeys covers GHSA-94c2-xg24-pwhv: the name of an attribute key
// expression is only known at render time, so the name must not be able to add
// attributes, and the value must be sanitized based on the name.
templ dynamicKeys(js string, injection string) {
	<a { "href" }={ js }>href</a>
	<a { "HREF" }={ js }>HREF</a>
	<form { "action" }={ js }></form>
	<div><turbo-stream { "action" }={ "append" }></turbo-stream></div>
	<img { "src" }={ "data:image/gif;base64,R0lGODlhAQABAAAAACw=" }/>
	<img { "src" }={ templ.SafeURL("data:image/gif;base64,R0lGODlhAQABAAAAACw=") }/>
	<button { "onclick" }={ js }>onclick string</button>
	<button { "onclick" }={ templ.JSFuncCall("alert", "hello") }>onclick ComponentScript</button>
	<button { "onclick" }={ handleDynamicKeyClick() }>onclick script template</button>
	<div style={ "color: red\"></div><script>alert(1)</script>" }>constant style string</div>
	<div { "style" }={ "color: red\"></div><script>alert(1)</script>" }>style string</div>
	<div { "style" }={ templ.SafeCSS("color: red") }>style SafeCSS</div>
	<iframe { "srcdoc" }={ "<script>alert(1)</script>" }></iframe>
	<div { injection }={ "value" }>invalid name with expression value</div>
	<div { injection }="value">invalid name with constant value</div>
	<div { injection }>invalid boolean name</div>
	<div { injection }?={ true }>invalid boolean expression name</div>
}
