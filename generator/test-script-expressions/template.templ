package testscriptexpressions

templ Script[T any](name string, data T) {
	<h1>{ name }</h1>
	<script>
		var a = {{ data }}
		var b = "{{ data }}"
		var c = '{{ data }}'
		var d = `{{ data }}`
	</script>
	<script>
		console.log({{ data }});
	</script>
}

// ScriptTemplateLiteralSubstitution covers GHSA-jq3r-rjqp-mwgj: a Go
// expression inside a `${ ... }` substitution of a backtick quoted template
// literal is in JavaScript expression position, so it must be JSON encoded
// like any other expression, rather than escaped as string data.
templ ScriptTemplateLiteralSubstitution[T any](name string, data T) {
	<h1>{ name }</h1>
	<script>
		var e = `Total: ${ {{ data }} }`
	</script>
}

templ AllTests() {
	@Script("string data", "hello")
	@Script("string data with quotes", "hello 'world'")
	@Script("numeric data", 123)
	@Script("boolean data", true)
	@Script("array data", []int{1, 2, 3})
	@Script("object data", struct {
		Name string
		Age  int
	}{"Alice", 30})
	@Script[*string]("null data", nil)
	@Script("template literal substitution syntax data", "${alert(document.domain)}")
	@ScriptTemplateLiteralSubstitution("template literal substitution data", "alert(document.domain)")
}

// RenderAfterIfCondition covers a '/' after the condition of an if statement,
// which starts a regular expression. If the tokenizer reads it as division,
// the quote in the regular expression is read as the start of a string, and
// data in code is escaped as string content, so that it executes.
templ RenderAfterIfCondition(data string) {
	<script>if (ok) /"/.test(s); var a = {{ data }};</script>
}

// RenderAfterPropertyNamedReturn covers a '/' after a property named return,
// which is division. If the tokenizer reads it as a regular expression, the
// quote in the string after it is skipped, and data in code is escaped as
// string content, so that it executes.
templ RenderAfterPropertyNamedReturn(data string) {
	<script>var a = b.return / 2; var c = "/"; var d = {{ data }};</script>
}

// RenderAfterNumberWithTrailingDecimalPoint covers a '/' after a number that
// ends with a decimal point, which is division. If the tokenizer reads the '.'
// as a property access, the '/' starts a regular expression, the quote in the
// string after it is skipped, and data in code is escaped as string content,
// so that it executes.
templ RenderAfterNumberWithTrailingDecimalPoint(data string) {
	<script>var a = 1. / 2; var c = "/"; var d = {{ data }};</script>
}

// RenderAtRegexpStart covers data at the start of a regular expression
// literal, where empty data would join the opening '/' to the next character.
templ RenderAtRegexpStart(data string) {
	<script>var r = /{{ data }}/;</script>
}

// RenderAtRegexpStartBeforeQuantifier covers data at the start of a regular
// expression literal that is followed by '*', where empty data would start a
// block comment.
templ RenderAtRegexpStartBeforeQuantifier(data string) {
	<script>var r = /{{ data }}*/;</script>
}

// RenderInRegexpClass covers data in a character class, where empty data must
// stay empty, so that no characters are added to the class.
templ RenderInRegexpClass(data string) {
	<script>var r = /[{{ data }}]/;</script>
}

// RenderInRegexpAfterHTMLOpenComment covers data in a regular expression after
// <!--, where a <script> start tag would stop </script> from ending the
// element.
templ RenderInRegexpAfterHTMLOpenComment(data string) {
	<script><!--
var r = /a{{ data }}/;</script>
}

// RenderAfterPostfixIncrement covers a '/' after a postfix increment, which is
// division.
templ RenderAfterPostfixIncrement(data string) {
	<script>var a = i++ / 2; var c = "/"; var d = {{ data }};</script>
}


// RenderAfterHTMLOpenComment covers <!--, which comments out the rest of the
// line in a classic script, so the quote after it does not start a string.
templ RenderAfterHTMLOpenComment(data string) {
	<script>
	<!-- "
	var a = {{ data }};
	</script>
}

// RenderInRegexp covers data in a regular expression literal. JSON encoding
// does not escape '/', so data in a regular expression must be escaped as
// string content, which escapes '/' and '\', so that it can't end the
// regular expression.
templ RenderInRegexp(data string) {
	<script>var r = /a{{ data }}/;</script>
}
